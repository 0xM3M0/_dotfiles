<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "fonts.dtd">
<fontconfig>

    <!-- 1. الإعدادات العامة لجودة العرض -->
    <match target="font">
        <edit name="antialias" mode="assign"><bool>true</bool></edit>
        <edit name="hinting" mode="assign"><bool>true</bool></edit>
        <edit name="autohint" mode="assign"><bool>false</bool></edit>
        <edit name="hintstyle" mode="assign"><const>hintfull</const></edit>
        <edit name="rgba" mode="assign"><const>none</const></edit>
        <edit name="lcdfilter" mode="assign"><const>lcddefault</const></edit>
        <edit name="embeddedbitmap" mode="assign"><bool>false</bool></edit>
    </match>

    <!-- 2. DPI: شاشتك 24" بدقة 1920×1080 = 92 DPI فعلي → القيمة القياسية 96 صحيحة.
         على Wayland يُتجاهل هذا غالباً، فاضبط المقياس من إعدادات سطح المكتب. -->
    <match target="pattern">
        <edit name="dpi" mode="assign"><double>96</double></edit>
    </match>

    <!-- 3. ترتيب خطوط Sans-Serif -->
    <alias>
        <family>sans-serif</family>
        <prefer>
            <family>Inter</family>
            <family>Vazirmatn</family>
            <family>Symbols Nerd Font</family>
        </prefer>
    </alias>

    <!-- 4. ترتيب خطوط Monospace -->
    <alias>
        <family>monospace</family>
        <prefer>
            <family>JetBrainsMono Nerd Font</family>
            <family>Vazirmatn</family>
            <family>Symbols Nerd Font</family>
        </prefer>
    </alias>

    <!-- 5. ترتيب خطوط Serif -->
    <alias>
        <family>serif</family>
        <prefer>
            <family>Noto Serif</family>
            <family>Vazirmatn</family>
            <family>Symbols Nerd Font</family>
        </prefer>
    </alias>

</fontconfig>
